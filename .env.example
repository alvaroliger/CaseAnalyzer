# ── CaseAnalyzer — Plantilla de entorno ──────────────────────────────────────
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a control de versiones.

# ── Backend Python (FastAPI/LeerDD) ──────────────────────────────────────────
FORENSIC_BACKEND_URL=http://localhost:8001
FORENSIC_TIMEOUT=120
FORENSIC_BACKEND_PORT=8001

# ── Laravel Core ─────────────────────────────────────────────────────────────
APP_NAME=CaseAnalyzer
APP_ENV=local           # local | production
APP_KEY=                # Genera con: php artisan key:generate
APP_DEBUG=false         # false en producción SIEMPRE
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error         # debug en desarrollo, error en producción

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# Para PostgreSQL/MySQL en producción:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=caseanalyzer
# DB_USERNAME=caseanalyzer
# DB_PASSWORD=

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=file

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
